import bmesh
from mathutils import Vector

def make_roof_prism(name, peak_h, overhang_x, overhang_y, c_col):
    """Build a gabled roof as a custom mesh."""
    W2 = HW/2 + overhang_x
    D2 = HD/2 + overhang_y
    PH = HH + peak_h
    verts = [
        Vector((-W2,  D2, HH)),  # 0 front-left eave
        Vector(( W2,  D2, HH)),  # 1 front-right eave
        Vector(( W2, -D2, HH)),  # 2 back-right eave
        Vector((-W2, -D2, HH)),  # 3 back-left eave
        Vector(( 0,   D2, PH)),  # 4 front ridge
        Vector(( 0,  -D2, PH)),  # 5 back ridge
    ]
    faces = [
        (0, 1, 4),          # front left slope
        (1, 2, 5, 4),       # right slope (quad)  -- wait, need to split
        (2, 3, 5),          # back right slope
        (3, 0, 4, 5),       # left slope (quad)
        (0, 3, 2, 1),       # soffit (optional, bottom of overhang)
    ]
    # Build properly: left slope, right slope, gable ends
    verts2 = [
        Vector((-W2,  D2, HH)),  # 0
        Vector(( W2,  D2, HH)),  # 1
        Vector(( W2, -D2, HH)),  # 2
        Vector((-W2, -D2, HH)),  # 3
        Vector(( 0,   D2, PH)),  # 4
        Vector(( 0,  -D2, PH)),  # 5
    ]
    faces2 = [
        (0, 4, 5, 3),   # left slope
        (1, 2, 5, 4),   # right slope
        (0, 1, 4),      # front gable
        (3, 5, 2),      # back gable
    ]
    me = bpy.data.meshes.new(name)
    me.from_pydata([v.to_tuple() for v in verts2], [], faces2)
    me.validate(); me.update()
    me.calc_normals_split()
    obj = bpy.data.objects.new(name, me)
    obj.data.materials.append(c_col)
    c_col_col = c_col  # material
    bpy.context.scene.collection.objects.link(obj)
    # move to target collection
    bpy.context.scene.collection.objects.unlink(obj)
    c_col_obj = c_col  # reuse variable name conflict — fix:
    return obj

